PORT=3001
NODE_ENV=development
JWT_SECRET=change-this-secret-in-production

# Supabase / PostgreSQL (usar DATABASE_URL en producción)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# O bien las variables individuales (para desarrollo local con Docker)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=carriup
# DB_USER=postgres
# DB_PASSWORD=postgres
